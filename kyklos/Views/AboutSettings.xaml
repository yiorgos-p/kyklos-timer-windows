<UserControl
    x:Class="Kyklos.Views.AboutSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Padding="0,28,0,8"
        HorizontalAlignment="Center"
        Spacing="14">
        <Image
            x:Name="Icon"
            Width="72"
            Height="72"
            AutomationProperties.AccessibilityView="Raw" />

        <StackPanel Spacing="3">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="kyklos" />
            <TextBlock
                x:Name="VersionText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Typography.NumeralAlignment="Tabular" />
        </StackPanel>

        <TextBlock
            MaxWidth="360"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="A small timer for one thing at a time, with focus and break rhythm, a reminder of what you're working on, and no ads or data collection."
            TextAlignment="Center"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Open source under the GNU GPLv3" />

        <HyperlinkButton
            HorizontalAlignment="Center"
            Content="kyklos for Mac"
            NavigateUri="https://github.com/yiorgos-p/kyklos-timer-mac" />
    </StackPanel>
</UserControl>
