<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Mica, the rounded flyout and mini timer, and the tray's look are Windows 11's. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Kyklos</RootNamespace>
    <AssemblyName>kyklos</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- For the few Win32 calls (tray icon, window chrome) that take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main starts kyklos instead, so a second launch can hand over to the first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kyklos.ico</ApplicationIcon>
    <!-- kyklos is in English only, so .NET's translated resources (satellite assemblies) are English only too. None of its
         packages ships any today; WinUI's own translations are Windows .mui files, left out below. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- About shows "Version 1.0 (Build 1)", as the Mac's does: the version, and the build in the file version's last
         place. -->
    <Version>1.0</Version>
    <FileVersion>1.0.0.1</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Not an MSIX package: it carries its own .NET and Windows App SDK, so the zip from GitHub runs on any Windows 11
         PC. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Builds the resource index, which holds the windows' compiled layouts; without it, `dotnet publish` leaves them
         out and the first window can't open. Named resources.pri rather than after the exe, so a kyklos.exe saved as
         "kyklos (1).exe" still finds it. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <!-- A release is a single kyklos.exe that runs from anywhere, like a portable app: .NET and the Windows App SDK are
       packed inside it, and it unpacks them into the temp folder the first time it starts. It leaves out the parts of
       .NET that kyklos doesn't use, which halves the download, and its debugging symbols. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Trimming turns off .NET's own COM support, which the taskbar progress (ITaskbarList3) goes through. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebugType>none</DebugType>
    <!-- Otherwise the trimmer gives each library it rewrites a symbol path naming the folder kyklos was built in. -->
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <!-- Compiled ahead of time rather than as it starts. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sounds\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licences go next to kyklos.exe, where people can read them, rather than inside it. -->
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\licenses\**" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- kyklos is in English only, so WinUI's own words (a text box's Cut, Copy and Paste, what a screen reader calls a
       scroll bar) stay in English too, as AppKit's do on the Mac for an app in one language. That leaves out the 85
       other languages of WinUI's .mui files; on a PC set to one of them, those fall back to English. (The few control
       names WinUI keeps in its resources.pri, which is merged into kyklos's, still come in every language.) -->
  <Target Name="LeaveOutOtherLanguages" AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- The folders are named in either case (en-us), and MSBuild compares strings without it. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.mui' and '$([System.IO.Path]::GetDirectoryName(%(RelativePath)))' != 'en-US'" />
    </ItemGroup>
  </Target>

  <!-- More that kyklos never uses, and would only unpack: the web view, the helper that restarts an app, the
       bootstrapper a self-contained app does without, Visual Studio's designer support, background tasks, and the
       controls' resources, which are merged into kyklos's own resources.pri along with its compiled XAML. The XAML and
       the other source files that get copied along go too. -->
  <PropertyGroup>
    <UnusedFiles>;Microsoft.Web.WebView2.Core.dll;WebView2Loader.dll;RestartAgent.exe;Microsoft.WindowsAppRuntime.Bootstrap.dll;Microsoft.UI.Designer.dll;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll;Microsoft.UI.Xaml.Controls.pri;NativeMethods.txt;app.manifest;</UnusedFiles>
  </PropertyGroup>
  <Target Name="LeaveOutUnusedParts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$(UnusedFiles.Contains(';%(Filename)%(Extension);')) or '%(Extension)' == '.xaml'" />
    </ItemGroup>
  </Target>

  <!-- kyklos uses none of the Windows App SDK's AI, machine learning, search, widget or DWriteCore parts, and as a
       self-contained app it doesn't need the framework installer either. Left in, they'd add about 60 MB to the zip. -->
  <ItemGroup>
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
  </ItemGroup>

</Project>
