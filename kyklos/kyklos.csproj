<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Mica, the rounded flyout and mini timer, and the tray's look are Windows 11's. -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Kyklos</RootNamespace>
    <AssemblyName>kyklos</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- For the few Win32 calls (tray icon, window chrome) that take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main starts kyklos instead, so a second launch can hand over to the first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kyklos.ico</ApplicationIcon>

    <!-- About shows "Version 1.0 (Build 1)", as the Mac's does: the version, and the build in the file version's last
         place. -->
    <Version>1.0</Version>
    <FileVersion>1.0.0.1</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- A plain folder rather than an MSIX package, carrying its own .NET and Windows App SDK, so the zip from GitHub
         runs on any Windows 11 PC. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sounds\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- kyklos uses none of the Windows App SDK's AI, machine learning, search, widget or DWriteCore parts, and as a
       self-contained app it doesn't need the framework installer either. Left in, they'd add about 60 MB to the zip. -->
  <ItemGroup>
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PrunePackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
  </ItemGroup>

</Project>
